# CRS V11.11-RC1 environment template. Never commit real secret values.
CRS_DEPLOYMENT_MODE=development
CRS_DATABASE_PATH=database/recipe.db
CRS_SECRET_KEY_FILE=instance/crs_secret_key
CRS_SESSION_TIMEOUT_MINUTES=30
CRS_SQLITE_BUSY_TIMEOUT_MS=15000
CRS_SQLITE_JOURNAL_MODE=WAL
CRS_SQLITE_SYNCHRONOUS=FULL

# Web service
CRS_HOST=127.0.0.1
CRS_PORT=5000
CRS_THREADS=4
CRS_TRUSTED_HOSTS=127.0.0.1,localhost
CRS_COOKIE_SECURE=0
CRS_ALLOW_STARTUP_MIGRATIONS=1
CRS_PLC_JOB_RECOVERY_ON_STARTUP=1
CRS_PLC_JOB_STALE_MINUTES=10

# PLC communication is fail-closed. Enable only in an approved plant window.
CRS_PLC_WORKER_ENABLED=0
CRS_ALLOW_PLC_COMMUNICATION=NO
CRS_ALLOW_LIVE_PLC_TESTS=NO

# Legacy recipe writes remain blocked.
CRS_ALLOW_LEGACY_RECIPE_WRITES=0
